{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PultGlavspeca",
  "version": "4.0.0",
  "identifier": "ru.tandem.glavspeca",
  "build": {
    "frontendDist": "../build/tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Пульт главспеца",
        "width": 1320,
        "height": 860,
        "minWidth": 280,
        "minHeight": 200,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ]
      }
    },
    "resources": {
      "../server/cabinet-server.js": "cabinet/cabinet-server.js",
      "../src/report/customer.js": "cabinet/lib/report/customer.js",
      "../src/renderer/logic.js": "cabinet/lib/renderer/logic.js",
      "../src/renderer/composition.js": "cabinet/lib/renderer/composition.js",
      "../src/renderer/calendar.js": "cabinet/lib/renderer/calendar.js",
      "../src/renderer/brand/tandem-logo.svg": "cabinet/lib/renderer/brand/tandem-logo.svg",
      "../src/renderer/fonts/GolosText.ttf": "cabinet/lib/renderer/fonts/GolosText.ttf",
      "../src/renderer/fonts/Montserrat.ttf": "cabinet/lib/renderer/fonts/Montserrat.ttf"
    }
  }
}
